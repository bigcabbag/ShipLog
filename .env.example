# 复制为 .env 并填入 Key: copy .env.example .env

# DeepSeek: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
# 读图（M5.3）：DeepSeek Chat API 不支持 image_url，需通义等多模态模型
# 模型说明：https://www.qianwenai.com/models/qwen3.7-flash
# 在 .env 填入 DASHSCOPE_API_KEY（或 VISION_API_KEY），Docker 改后需 force-recreate backend
DASHSCOPE_API_KEY=
VISION_MODEL=qwen3.7-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 也可只写 VISION_API_KEY=sk-xxx 而不写 DASHSCOPE_API_KEY（二选一即可）

# Embedding（DeepSeek 无 Embedding API，用本地中文模型）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 国内镜像（首次下载 Embedding 模型用，有 VPN 可注释掉）
# HF_ENDPOINT=https://hf-mirror.com

# --- Docker Compose（M5.1）---
# 1. copy .env.example .env 并填入 DEEPSEEK_API_KEY + PG 凭据
# 2. docker compose up --build
# 3. 浏览器 http://localhost:5173（API 经 frontend nginx 反代，curl 调试仍可用 http://localhost:8032/health）
# 4. 首次入库: docker compose exec backend uv run python scripts/import_docs.py
# PostgreSQL(pgvector): 自动启动，DATABASE_URL 由 compose 从下方变量拼装注入
# 数据卷: pg_data(向量+trace) ./data/bm25 ./data/uploads

# PostgreSQL 凭据（改成你自己的，.env 不上传 GitHub）
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=rag

# 通义: https://dashscope.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus
