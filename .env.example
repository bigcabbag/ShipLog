# 复制为 .env 并填入 Key: copy .env.example .env

# DeepSeek: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash

# Embedding（DeepSeek 无 Embedding API，用本地中文模型）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 国内镜像（首次下载 Embedding 模型用，有 VPN 可注释掉）
# HF_ENDPOINT=https://hf-mirror.com

# --- Docker Compose（M5.0）---
# 1. copy .env.example .env 并填入 DEEPSEEK_API_KEY
# 2. docker compose up --build
# 3. 浏览器 http://localhost:5173 ，API http://localhost:8032/health
# 4. 首次入库: docker compose exec backend uv run python scripts/import_docs.py
# 数据卷: ./data/chroma ./data/bm25 ./data/traces ./data/uploads

# 通义: https://dashscope.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus
