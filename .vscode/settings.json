{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "basedpyright.analysis.venvPath": ".",
  "basedpyright.analysis.venv": ".venv",
  "python.analysis.diagnosticMode": "workspace",
  "terminal.integrated.env.windows": {
    "Path": "${env:USERPROFILE}\\.local\\bin;${env:Path}"
  },
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "json.schemas": [
    {
      "fileMatch": ["frontend/tsconfig.json", "frontend/tsconfig.*.json"],
      "url": "https://json.schemastore.org/tsconfig"
    }
  ]
}
