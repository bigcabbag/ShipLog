{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "basedpyright.analysis.venvPath": ".",
  "basedpyright.analysis.venv": ".venv",
  "python.analysis.diagnosticMode": "workspace",
  "terminal.integrated.env.windows": {
    "Path": "${env:USERPROFILE}\\.local\\bin;${env:Path}"
  },
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "material-icon-theme.files.associations": {
    "docker-compose.yml": "docker",
    "docker-compose.yaml": "docker",
    "compose.yml": "docker",
    "compose.yaml": "docker"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "docker-compose.yml": "Dockerfile, .dockerignore",
    "pyproject.toml": "uv.lock, uv.lock.*, .python-version, pyrightconfig.json",
    "README.md": ".env.example, .gitignore",
    ".env.example": ".env, .env.local"
  },
  "json.schemas": [
    {
      "fileMatch": ["frontend/tsconfig.json", "frontend/tsconfig.*.json"],
      "url": "https://json.schemastore.org/tsconfig"
    }
  ]
}
